# Caddyfile.prod — production reverse proxy + edge caching for Kapp.
#
# Used by the `caddy` service in docker-compose.prod.yml. It replaces
# the previous inline `caddy reverse-proxy` command so the production
# edge can set per-path Cache-Control headers and negotiate compression
# in addition to terminating TLS.
#
# Topology: Caddy is the public TLS edge in front of the `api` service,
# which is the origin for BOTH the React SPA (Vite build) and the
# /api/v1 surface. Caddy does not serve files itself here — it proxies
# everything to api:8080 and layers caching + compression on top. The
# authoritative Cache-Control values are also set at the origin by
# platform.CacheControlMiddleware (internal/platform/cache_control.go);
# the rules below mirror them so the policy holds even if a future
# origin response forgets to set one.
#
# Environment variables (provided by the caddy service in
# docker-compose.prod.yml):
#   KAPP_DOMAIN — public hostname. Defaults to `localhost`, which makes
#                 Caddy use its internal CA for local HTTPS so the prod
#                 compose can be smoke-tested without a real domain.
#
# Automatic HTTPS is enabled for a real KAPP_DOMAIN with no further
# configuration (Let's Encrypt accepts an account with no contact
# email). To receive certificate-expiry notices, add a global options
# block at the top of this file with your address, e.g.:
#
#   {
#       email ops@example.com
#   }
#
# It is intentionally omitted here because an empty value (the
# localhost / internal-CA case) would make the `email` directive a
# parse error.

{$KAPP_DOMAIN:localhost} {
	# Negotiate response compression. zstd is preferred by clients
	# that advertise it; gzip is the universal fallback. Caddy skips
	# already-compressed content types (images, video) automatically.
	encode gzip zstd

	# Vite emits content-hashed bundles under /assets/ (e.g.
	# index-a1b2c3d4.js). The hash IS the cache key, so these can be
	# cached for a year and never revalidated — a new deploy ships new
	# filenames, and the old URLs are simply never requested again.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# The SPA shell (index.html, served at /) must revalidate on every
	# navigation so a new deploy — which rewrites index.html to point at
	# the new hashed bundles — is picked up immediately instead of being
	# pinned by a stale cached document.
	header / Cache-Control "no-cache"

	# Everything (SPA shell, hashed assets, and the dynamic /api/v1
	# surface) is proxied to the origin. The origin sets no-store on
	# /api/v1 responses (tenant-scoped, RLS-isolated — must never be
	# cached); Caddy leaves those headers untouched because the matchers
	# above only cover /assets/* and the exact / path.
	reverse_proxy api:8080
}
